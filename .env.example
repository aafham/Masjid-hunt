# Optional. Without Google keys, the attributed, dated OpenStreetMap snapshot is used.
# Server only: restrict these keys to the necessary Google APIs.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Optional, browser-visible embed key: restrict to Maps Embed API + site referrers.
# Never reuse the private server keys above.
GOOGLE_MAPS_EMBED_API_KEY=

# Optional self-hosted/managed Overpass endpoint to enable live OSM queries.
# Leave blank to use the checked-in snapshot instantly, with no external requests.
# Update the snapshot with scripts/import-mosques.mjs and a genuine Overpass export.
OVERPASS_API_URL=
